# =============================================================================
# Binaries.nl environment template — placeholders only; never commit secrets
# =============================================================================
# Copy to .env for local development. Use .env.production as a local reference
# for production values, then mirror the same keys in Vercel Environment Variables.
#
# Public app URL: set VITE_APP_URL, FRONTEND_URL, and BETTER_AUTH_URL to the same
# origin users visit (localhost in dev; your domain in production).
# =============================================================================

# --- APPLICATION ---
APP_NAME=Binaries.nl
APP_COMPANY_NAME=Binaries.nl
VITE_APP_URL=http://localhost:5173
VITE_CONTACT_EMAIL=

# --- AUTHENTICATION (Better Auth) ---
# BETTER_AUTH_SECRET: min 32 chars; generate per environment (never reuse SendStack).
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# console = log links (dev) | smtp = use SMTP_* | resend = use Resend | disabled
AUTH_EMAIL_DELIVERY=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- DATABASE (Neon PostgreSQL — independent Binaries.nl project) ---
# App runtime: Neon pooled URL (hostname contains -pooler) with sslmode=require.
# Migrations: if the pooler rejects a migration, use the direct (non-pooler) URL
# for `npm run db:migrate` only, then point the app back at the pooled URL.
# Local PostgreSQL: postgresql://USER:PASSWORD@127.0.0.1:5432/kivorenta?sslmode=disable
# See docs/DATABASE-CONNECTIVITY.md. Check with `npm run db:check` (no secrets printed).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional. Long-running server default is 10; Vercel always uses 1.
# DATABASE_POOL_MAX=10
# Optional. Rounded up to seconds. Defaults: 10000 local/Railway, 8000 on Vercel.
# DATABASE_CONNECT_TIMEOUT_MS=10000
# Eligible recipients allowed in one Settings → Test List send. Default 8. Maximum 25.
# TEST_MESSAGE_MAX_LIST_RECIPIENTS=8

# --- REDIS / QUEUE (BullMQ via ioredis) ---
# Use redis:// locally; production Upstash TCP/TLS uses rediss:// (not HTTPS REST).
QUEUE_ENABLED=false
QUEUE_SIMULATION_ONLY=true
QUEUE_NAMESPACE=kivorenta
REDIS_URL=
# Optional tuning:
# QUEUE_WORKER_CONCURRENCY=2
# QUEUE_MAX_JOBS_PER_SECOND=5
# QUEUE_MAX_ATTEMPTS=3
# QUEUE_JOB_RETENTION_DAYS=7
# QUEUE_SIMULATION_DELAY_MS=25
# QUEUE_SIMULATION_FORCE_FAIL=1

# --- OUTBOUND MAIL (Resend selected by default; Spacemail SMTP is optional) ---
# Verify this sender's domain in Resend and use an aligned sending subdomain.
# Set SMTP_* to enable Spacemail as an alternative outbound provider in Mailbox settings.
# --- MAILBOX (optional Spacemail inbound IMAP + mailbox login) ---
# Outbound Resend delivery does not require these mailbox credentials.
SPACEMAIL_IMAP_HOST=mail.spacemail.com
SPACEMAIL_IMAP_PORT=993
SPACEMAIL_IMAP_SECURE=true
SPACEMAIL_EMAIL=
SPACEMAIL_PASSWORD=
SPACEMAIL_SENDER_NAME=
# Optional comma-separated allowlist for single-recipient test sends.
MAIL_TEST_RECIPIENTS=recipient-one@example.com,recipient-two@example.com,recipient-three@example.com
# Legacy names remain supported when MAIL_TEST_RECIPIENTS is unset.
# SPACEMAIL_TEST_RECIPIENTS=
# SPACEMAIL_TEST_RECIPIENT=

# --- SERVER ---
PORT=3001
# NODE_ENV=development

# --- BOOTSTRAP / SCRIPTS (CLI: npm run bootstrap:admin) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
# Optional. If unset, the CLI generates a one-time temporary password (shown once).
# BOOTSTRAP_ADMIN_PASSWORD=

# Invitation expiry (hours, default 48)
# USER_INVITATION_TTL_HOURS=48

# Optional CLI: mark an existing account for password rotation (does not reset password)
# SECURITY_ROTATION_EMAIL=
# SENDSTACK_DB_RESET_CONFIRM=yes

# --- ENV FILE SELECTION ---
# APP_ENV_FILE=.env.production
# SENDSTACK_ENV_FILE=.env.production

# --- VERCEL (set in dashboard, not necessarily in .env) ---
# VERCEL=1
