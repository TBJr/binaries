# =============================================================================
# Binaries.nl v0.1.0 — production environment template (safe to commit)
# =============================================================================
# Copy to .env.production locally, fill placeholders, then mirror in:
#   - Vercel Dashboard → Project → Settings → Environment Variables → Production
#   - Railway services (worker, dispatcher) for shared infrastructure keys
# =============================================================================

# --- 1. Application Environment ---
NODE_ENV=production
APP_NAME=Binaries.nl
APP_COMPANY_NAME=

# --- 2. Production URLs and Domains ---
VITE_APP_URL=https://YOUR_PRODUCTION_DOMAIN
FRONTEND_URL=https://YOUR_PRODUCTION_DOMAIN
BETTER_AUTH_URL=https://YOUR_PRODUCTION_DOMAIN

# --- 3. Better Auth Configuration ---
BETTER_AUTH_SECRET=
AUTH_EMAIL_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- 4. PostgreSQL Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- 5. Redis Configuration ---
REDIS_URL=rediss://USER:PASSWORD@HOST:6379

# --- 6. SMTP Configuration (operational mailbox) ---
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=587
SPACEMAIL_SMTP_SECURE=false
SPACEMAIL_EMAIL=
SPACEMAIL_PASSWORD=
SPACEMAIL_SENDER_NAME=

# --- 7. IMAP Configuration ---
SPACEMAIL_IMAP_HOST=mail.spacemail.com
SPACEMAIL_IMAP_PORT=993
SPACEMAIL_IMAP_SECURE=true
SPACEMAIL_TEST_RECIPIENTS=

# --- 8. Campaign Queue Configuration ---
QUEUE_ENABLED=true
QUEUE_SIMULATION_ONLY=true
QUEUE_NAMESPACE=kivorenta

# --- 9. Security Configuration ---
# USER_INVITATION_TTL_HOURS=48

# --- 11. Vite Frontend Variables ---
VITE_CONTACT_EMAIL=

# --- 12. Other ---
PORT=3001
